# Postgres connection string. Locally you can run `npx prisma dev` to spin up
# a throwaway local Postgres and it will print a DATABASE_URL for you.
# In production, use your real Postgres (Supabase / Neon / Railway / RDS / ...).
# If your provider's pooler is PgBouncer (or similar) in transaction mode,
# append &pgbouncer=true — Prisma needs that to disable prepared statement caching.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Admin login for /admin (product management: add/remove, price, availability,
# description). Generate ADMIN_PASSWORD_HASH with:
#   npx tsx -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
#
# IMPORTANT — the `$` in a bcrypt hash (it always starts with $2b$ or similar)
# needs different handling depending on where the value lives:
#   - In a local ".env" FILE loaded by Next.js: escape every `$` as `\$`,
#     because Next.js's dotenv-expand treats unescaped `$name` as a variable
#     reference and silently corrupts the hash.
#   - In a platform's dashboard env vars (Vercel/Railway/Render/...) or any
#     other place that sets the variable directly (not by parsing a .env
#     file): paste the RAW hash, unescaped — those do not run dotenv-expand,
#     so escaped backslashes would themselves become part of the hash and
#     break it just the same.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="\$2b\$10\$replace-with-your-own-generated-hash"

# Random secret used to sign the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

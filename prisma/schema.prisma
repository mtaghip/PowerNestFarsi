// Uses the classic `prisma-client-js` generator, which emits into
// node_modules/.prisma/client and is consumed via the `@prisma/client`
// package. That matters on Vercel: `@prisma/client` is in Next.js's built-in
// serverExternalPackages list, so it is require()'d natively instead of being
// bundled. The newer `prisma-client` generator with a custom output path under
// app/ gets bundled by Turbopack, which rewrites the `import.meta.url` it uses
// to locate its own directory — Prisma then looks for its query engine next to
// the emitted chunk and fails at runtime with "could not locate the Query
// Engine for runtime rhel-openssl-3.0.x".
//
// binaryTargets: Vercel builds on Debian but runs functions on an
// Amazon-Linux/RHEL runtime, so the RHEL engine has to be generated too.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  brand       String
  category    String
  price       Int
  rating      Int      @default(5)
  reviewCount Int      @default(0)
  stock       Boolean  @default(true)
  badge       String?
  power       String
  voltage     String
  warranty    String
  extra       String
  description String
  image       String
  // Datasheet rows as [{ k: label, v: value }]. When present the product page
  // renders these instead of the generic placeholder spec rows.
  specs       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviews    Review[]
  cartItems  CartItem[]
  orderItems OrderItem[]
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  author    String
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  @@index([productId])
}

model Cart {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int

  @@unique([cartId, productId])
}

model Order {
  id            String      @id @default(cuid())
  trackingCode  String      @unique
  name          String
  phone         String
  province      String
  postalCode    String
  address       String
  paymentMethod String
  status        String      @default("pending")
  subtotal      Int
  vat           Int
  shipping      Int
  total         Int
  createdAt     DateTime    @default(now())
  items         OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  price     Int
  quantity  Int
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  phone       String
  company     String?
  city        String
  projectType String
  message     String
  // Slug of the product whose استعلام button started this enquiry, null when
  // it came from the consult page directly. Deliberately not a relation: the
  // enquiry records what the customer asked about and has to survive that
  // product being renamed or deleted.
  productSlug String?
  // The inbox's read/unread flag, set once someone has dealt with the enquiry.
  handled     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([handled, createdAt])
}
